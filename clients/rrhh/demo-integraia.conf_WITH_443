# ============================================
# SUBDOMINIO postiz.demo.integraia.lat
# ============================================
server {
    listen 80;
    server_name postiz.demo.integraia.lat;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name postiz.demo.integraia.lat;

    ssl_certificate /etc/letsencrypt/live/postiz.demo.integraia.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/postiz.demo.integraia.lat/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/postiz.demo.integraia.lat/chain.pem;
    include snippets/ssl.conf;
    include snippets/letsencrypt.conf;

    underscores_in_headers on;
    client_max_body_size 50M;
    
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Ssl on;
    
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    location /rails/active_storage/ {
        proxy_pass http://postiz_demo;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Ssl on;
        expires 1y;
        add_header Cache-Control "public, immutable";
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /cable {
        proxy_pass http://postiz_demo;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 86400s;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|webp)$ {
        proxy_pass http://postiz_demo;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self' https: data:; media-src 'self' https:; style-src 'none'; script-src 'none'; frame-ancestors 'none'; sandbox";
        expires 1y;
        add_header Cache-Control "public, immutable";
        proxy_buffering off;
    }

    location /uploads/ {
        alias /var/www/postiz_uploads/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    location / {
        proxy_pass http://postiz_demo;
        proxy_redirect off;
    }
}

