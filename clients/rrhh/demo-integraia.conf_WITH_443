# ============================================
# DOMINIO PRINCIPAL demo.integraia.lat (Odoo principal)
# ============================================
server {
    listen 80;
    server_name demo.integraia.lat;
    include snippets/letsencrypt.conf;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name demo.integraia.lat;

    ssl_certificate /etc/letsencrypt/live/demo.integraia.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.integraia.lat/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/demo.integraia.lat/chain.pem;
    include snippets/ssl.conf;
    include snippets/letsencrypt.conf;

    access_log /var/log/nginx/odoo_demo.access.log;
    error_log /var/log/nginx/odoo_demo.error.log;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    proxy_read_timeout 720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout 720s;

    location ~ \.css$ {
        proxy_pass http://odoo_demo;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Content-Type "text/css" always;
    }

    location ~* /web/static/ {
        proxy_pass http://odoo_demo;
        proxy_cache_valid 200 90m;
        proxy_buffering on;
        expires 864000;
        add_header Cache-Control "public, immutable";

        location ~ \.css$ {
            add_header Content-Type "text/css" always;
        }
    }

    location / {
        proxy_pass http://odoo_demo;
        proxy_redirect off;
    }

    location /longpolling/ {
        proxy_pass http://odoo_demo_longpolling;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
        proxy_connect_timeout 900s;
        proxy_send_timeout 900s;
    }
}

